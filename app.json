{
  "expo": {
    "name": "Rodaku",
    "slug": "rodaku",
    "scheme": "rodaku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rodaku.app"
    },
    "android": {
      "package": "com.rodaku.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#12355B"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#07090E",
      "translucent": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F59E0B"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/82758821-0835-464f-8edd-e6cc1177cb83"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82758821-0835-464f-8edd-e6cc1177cb83"
      }
    }
  }
}
